# ---------------------------------------------------------------------------
# VORTEX server configuration. Copy this file to `.env` and fill in the values.
# Everything below is a PLACEHOLDER. Never commit a real .env file or paste real secrets here.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
PORT=5000
# development | production. On a real server this MUST be "production" (secure cookies, no stack traces, strict secrets).
NODE_ENV=development
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The website address(es) allowed to call the API (comma separated). Production example: https://shop.example.com
CLIENT_URL=http://localhost:5173
# Login cookie: lax (default) works when the site and API share a domain. Use none only for a separate API domain over HTTPS.
COOKIE_SAMESITE=lax

# --- Database ---------------------------------------------------------------
# Local development (standalone MongoDB, no transactions):
MONGO_URI=mongodb://127.0.0.1:27017/vortex
# Local single-node replica set (enables transactions; see README "MongoDB local replica set"):
#   MONGO_URI=mongodb://127.0.0.1:27017/vortex?replicaSet=rs0
# MongoDB Atlas (a replica set, so transactions are on automatically). Copy the string from Atlas > Connect > Drivers:
#   MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/vortex?retryWrites=true&w=majority
# auto = use transactions when the server supports them (default); off = never use them.
MONGO_TRANSACTIONS=auto
MONGO_MAX_POOL_SIZE=10

# --- Store settings (shown to customers; safe defaults shown) ----------------
STORE_NAME=VORTEX
# ISO 4217 currency code (USD, EGP, EUR ...) and the locale used to format prices (en-US, ar-EG, ...)
CURRENCY=USD
CURRENCY_LOCALE=en-US
SHIPPING_FLAT_RATE=5
FREE_SHIPPING_THRESHOLD=100
# Promo code advertised in the announcement bar. It must exist as a coupon (Admin > Coupons). Leave empty for none.
# (When this line is absent, development uses the seeded demo coupon VORTEX10 and production shows none.)
PROMO_CODE=VORTEX10

# --- Public business details (all optional; shown on the Contact, Privacy and Returns pages) ---
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
# Number of days customers have to request a return. Leave empty until you have decided: no promise is shown while it is empty.
RETURN_WINDOW_DAYS=

# --- Email (SMTP) -----------------------------------------------------------
# Optional. Without SMTP the shop works normally; order emails are skipped and the contact form says email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VORTEX <no-reply@example.com>"
# Private inbox that receives contact-form messages (not shown to visitors). The contact form needs this AND SMTP.
CONTACT_TO=

# --- Files ------------------------------------------------------------------
# Where uploaded product images are stored (default: server/uploads). Use a persistent disk in production.
UPLOADS_DIR=
# Optional: Cloudinary (falls back to local /uploads when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
